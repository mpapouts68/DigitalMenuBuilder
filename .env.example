# Copy to `.env` for docker compose / Hostman (do not commit `.env`).
# Host port -> container listens on 5000 inside the image.
HOST_PORT=5000

# SQLite (persisted via docker-compose volume `menu_data` at /data)
DATABASE_PATH=/data/menu.db

# Required for production — generate a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# API user accounts (change defaults)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
PRINTER_USERNAME=printer
PRINTER_PASSWORD=printer123

# Embedded server-side printer dispatch worker:
# - local/dev: enabled by default
# - production/hosted: disabled by default (use /printer page on local machine)
# Set to 1 to force enable, 0 to force disable.
# EMBEDDED_PRINTER_ENABLED=0

# Viva Smart Checkout (card payments) — required for card checkout
# VIVA_ENVIRONMENT=production
# VIVA_CLIENT_ID=          # Settings → API Access → Smart Checkout Client ID
# VIVA_CLIENT_SECRET=      # Smart Checkout Client Secret (keep private)
# VIVA_SOURCE_CODE=       # Sales → Online payments → your Websites/Apps source → Source code
# VIVA_SUCCESS_URL=https://www.shishapoint.site/payment/success
# VIVA_FAILURE_URL=https://www.shishapoint.site/payment/failed
# VIVA_WEBHOOK_KEY=
# Webhook URL in Viva dashboard: https://www.shishapoint.site/api/webhooks/viva
